# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/certificates_db
POSTGRES_DB=certificates_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage
STORAGE_PATH=/app/storage/certificates

# Sandbox config
SANDBOX_THRESHOLD=10
SANDBOX_IMAGE=bulk-certificate-generator-pdf-generator:latest
SANDBOX_CONTAINER_PREFIX=sandbox
SANDBOX_VOLUME=bulk-certificate-generator_certificate_storage
SANDBOX_NETWORK=bulk-certificate-generator_default
SANDBOX_MEM_LIMIT=256m
SANDBOX_TIMEOUT_SECONDS=300

# App
APP_VERSION=1.0.0
DEBUG=true
